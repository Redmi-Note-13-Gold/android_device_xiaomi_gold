service vendor.health-gold /vendor/bin/hw/android.hardware.health-service.gold
    class hal
    user system
    group system
    capabilities WAKE_ALARM BLOCK_SUSPEND
    file /dev/kmsg w

service vendor.charger /vendor/bin/hw/android.hardware.health-service.gold --charger
    class charger
    disabled
    seclabel u:r:charger_vendor:s0
    user system
    group system graphics wakelock input
    capabilities SYS_BOOT
    file /dev/kmsg w
    file /sys/fs/pstore/console-ramoops-0 r
    file /sys/fs/pstore/console-ramoops r
    file /proc/last_kmsg r

on charger
    # The display driver is loaded by the module script, and the charger UI
    # only initializes its display once, so wait until all modules are in.
    wait_for_prop vendor.all.modules.ready 1
    wait /dev/dri/card0 20
    chown system system /dev/graphics/fb0
    chown system system /dev/dri/card0
    # The backlight comes up before the display and is left dark. The charger
    # sets it again after every unblank, so it needs the node that early-boot
    # hands to system in a normal boot.
    chown system system /sys/class/leds/lcd-backlight/brightness
    chmod 0664 /sys/class/leds/lcd-backlight/brightness
    write /sys/class/leds/lcd-backlight/brightness 1638
    start vendor.charger
