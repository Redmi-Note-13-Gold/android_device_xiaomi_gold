# Market name is supplied by the SKU configuration and consumed by the stock
# radio implementation.
get_prop(rild, system_gold_marketname_prop)

# The stock radio implementation looks for MIUI version properties
# (ro.mi.os.version.*, ro.miui.ui.version.code, ro.product.mod_device, ro.fota.oem).
dontaudit rild default_prop:file read;
