# Camera thermal throttling and AIDL sensor access.
r_dir_file(mtk_hal_camera, sysfs_therm)
allow mtk_hal_camera fwk_sensor_service:service_manager find;

# Legacy stock blobs use system-owned camera properties without a vendor
# prefix. Keep their ownership in system_ext and expose only the required
# access to the vendor camera HAL.
set_prop(mtk_hal_camera, system_gold_camera_runtime_prop)
get_prop(mtk_hal_camera, system_gold_camera_config_prop)

# Runtime dual-camera calibration state.
allow mtk_hal_camera gold_camera_data_file:dir create_dir_perms;
allow mtk_hal_camera gold_camera_data_file:file create_file_perms;

# Factory calibration is read-only at runtime.
allow mtk_hal_camera persist_data_file:dir search;
allow mtk_hal_camera gold_camera_persist_file:dir r_dir_perms;
allow mtk_hal_camera gold_camera_persist_file:file r_file_perms;

# Debug switches without a vendor prefix (demo.*, debuglog.drv*,
# cam.egnsavefile.enable). Nothing sets them.
dontaudit mtk_hal_camera default_prop:file read;
