# Xiaomi thermal policy daemon.
type mi_thermald, domain;
type mi_thermald_exec, exec_type, file_type, vendor_file_type;

typeattribute mi_thermald mlstrustedsubject;

init_daemon_domain(mi_thermald)

# Stock daemon capabilities used for cooling controls and suspend alarms.
allow mi_thermald self:capability { chown fowner fsetid sys_admin sys_boot };
allow mi_thermald self:capability2 { block_suspend wake_alarm };

# CPU, thermal-zone, display and battery cooling nodes.
allow mi_thermald sysfs:dir r_dir_perms;
allow mi_thermald sysfs_devices_system_cpu:file rw_file_perms;
r_dir_file(mi_thermald, sysfs_thermal)
allow mi_thermald sysfs_thermal:file w_file_perms;
r_dir_file(mi_thermald, sysfs_leds)
allow mi_thermald sysfs_leds:file w_file_perms;
r_dir_file(mi_thermald, sysfs_batteryinfo)
allow mi_thermald sysfs_batteryinfo:file w_file_perms;

# MediaTek thermal-message controls.
allow mi_thermald sysfs_therm:dir r_dir_perms;
allow mi_thermald sysfs_therm:file rw_file_perms;

# Runtime state created below /data/vendor/thermal.
allow mi_thermald thermal_core_data_file:dir create_dir_perms;
allow mi_thermald thermal_core_data_file:file create_file_perms;

# Runtime thermal mode properties use the existing MediaTek property type.
set_prop(mi_thermald, vendor_thermal_prop)

# Transparent huge-page tuning performed by the stock daemon.
allow mi_thermald sysfs_transparent_hugepage:file rw_file_perms;
